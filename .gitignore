# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native prebuild output — regenerated by `npx expo prebuild` on every checkout,
# and bakes copies of the Firebase config, keystore, and bundle id into the
# tree. Never commit.
android/
ios/

# Build artifacts
*.apk
*.aab
*.ipa
build-*.apk
build-*.aab

# Native signing keys — NEVER commit these
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# EAS local signing secrets — NEVER commit these
credentials.json
credentials/

# Firebase config with API keys / project ids — NEVER commit these.
# `.example` templates ARE safe to commit; the real files are secrets.
firebase/google-services.json
firebase/GoogleService-Info.plist
firebase/.databaseurl
firebase/databaseurl

# Metro
.metro-health-check*

# macOS
.DS_Store

# Env files (contain FIREBASE_DATABASE_URL and other runtime config).
# `.env.example` is safe to commit; anything else is not.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Runtime config for LineWatch. Copy to .env and fill in.
# Anything prefixed with EXPO_PUBLIC_ is inlined into the JS bundle at build
# time, so treat these as "public constants shipped to the client" — never put
# private admin secrets here.

# Firebase Realtime Database URL for your project. Find it in Firebase console
# → Realtime Database → Data (top of the page).
# Example: https://linewatch-abc12-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Set to 1 to force the mock (offline, encrypted MMKV) data path even in a
# real build. Handy for demos or when you don't want to talk to Firebase.
# Leave unset (or 0) to use Firebase.
# EXPO_PUBLIC_USE_MOCK=0

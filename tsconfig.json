{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@app": ["./src/app"],
      "@app/*": ["./src/app/*"],
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@ds": ["./src/design-system"],
      "@ds/*": ["./src/design-system/*"],
      "@features": ["./src/features"],
      "@features/*": ["./src/features/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js"]
}
